{
  "name": "jev-playground",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run sample:check",
    "audit": "npm audit --audit-level=high",
    "fixture:validate": "node scripts/generate-football-fixture.mjs --validate",
    "sample:generate": "node scripts/generate-sample-dataset.mjs",
    "sample:check": "node scripts/generate-sample-dataset.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/functions": "^3.9.8",
    "convex": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.37",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
