{
  "name": "jev-gamecast",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "20.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test": "vitest run",
    "test:convex": "vitest run convex/*.test.ts",
    "typecheck": "tsc -b",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=high",
    "test:watch": "vitest",
    "fixture:validate": "node scripts/generate-football-fixture.mjs --validate",
    "samples:export": "node scripts/export-sample-csvs.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqids": "^0.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "convex-test": "^0.0.37",
    "jsdom": "^25.0.1",
    "vitest": "^5.0.1"
  }
}
