# Server-side only. Never prefix a secret with VITE_: that would ship it to the browser.

# --- Durable storage (required for uploads, runs and share links) -------------
# The Convex deployment URL is not a secret. VITE_CONVEX_URL is accepted as an alias.
CONVEX_URL=https://your-deployment.convex.cloud
# Shared secret. Set the same value on the Convex deployment (npx convex env set CONVEX_WRITE_SECRET ...)
# and on the server runtime. Generate with: openssl rand -hex 32
CONVEX_WRITE_SECRET=

# --- Providers ---------------------------------------------------------------
# Jev classifier. Without it, runs are unavailable (or simulated, see below).
JEV_API_KEY=
# Drafts the question and labels. Optional: without it people write them by hand.
OPENROUTER_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Spend and abuse limits (defaults shown) ----------------------------------
# JEV_RUNS_DISABLED=1          # kill switch: refuse all new and resumed runs
# JEV_DAILY_CALL_BUDGET=20000  # Jev calls reserved per UTC day across all users
# JEV_MAX_ROWS_PER_RUN=5000    # hard ceiling is 5000
# JEV_RUNS_PER_HOUR=10         # per client address
# JEV_DRAFTS_PER_HOUR=30       # per client address
# JEV_UPLOADS_PER_HOUR=20      # per client address
# JEV_CONCURRENCY=2            # parallel Jev calls per run (1-8)

# --- Hosting -----------------------------------------------------------------
# Only needed off Vercel, or to force the origin used for link previews and for
# a long run handing itself to the next invocation.
# JEV_PUBLIC_ORIGIN=https://your-site.example

# --- Local development only --------------------------------------------------
# `npm run dev` sets these automatically when nothing else is configured.
# JEV_PLAYGROUND_STORAGE=local  # process-local storage; ignored on Vercel
# JEV_PLAYGROUND_MOCK=1         # simulated drafting/classification when a key is missing
